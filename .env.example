# Configuration du serveur Atelier Lexical
PORT=3001
NODE_ENV=development

# Clé API optionnelle pour l'assistant stylistique par IA (Gemini ou OpenAI)
# L'application fonctionne intégralement sans IA grâce aux sources lexicales vérifiées et au moteur de nuances.
# GEMINI_API_KEY=votre_cle_gemini_ici
# OPENAI_API_KEY=votre_cle_openai_ici
